rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isPluginSubmissionAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in [
          "marcyap@orbitalai.net",
          "marcyap@fastmail.com"
        ];
    }

    // ── developers/{uid} ──────────────────────────────────────────────
    // Owner can read and write their own doc. No deletes.
    match /developers/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── api_keys/{key} ────────────────────────────────────────────────
    // Server-side Admin SDK only. No client access.
    match /api_keys/{key} {
      allow read, write: if false;
    }

    // ── plugins/{pluginId} ────────────────────────────────────────────
    // Any authenticated user can read approved plugins.
    // Only the owning developer can create, update, or delete.
    match /plugins/{pluginId} {
      allow read: if request.auth != null && resource.data.status == "approved";
      allow create: if request.auth != null
                    && request.resource.data.developer_uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.developer_uid == request.auth.uid;
    }

    // ── plugin_submissions ────────────────────────────────────────────
    // Developers create pending rows and read their own docs.
    // Allowlisted admins (same emails as admin-submissions.html) list and review.
    match /plugin_submissions/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.developer_uid == request.auth.uid
                    && request.resource.data.status == "pending";
      allow read: if request.auth != null
                  && (resource.data.developer_uid == request.auth.uid
                      || isPluginSubmissionAdmin());
      allow update: if isPluginSubmissionAdmin()
                    && request.resource.data.developer_uid == resource.data.developer_uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "review_notes", "reviewed_at", "reviewed_by"]);
      allow delete: if false;
    }

    // ── submissions (new collection from backlog reconciliation) ──────
    match /submissions/{docId} {
      allow create: if request.auth != null;
      allow read, update: if false;
      allow delete: if false;
    }

    // ── swarmspace_usage/{docId} ──────────────────────────────────────
    // Credit enforcement. Server-side only (router writes via Admin SDK).
    match /swarmspace_usage/{docId} {
      allow read, write: if false;
    }

    // ── plugin_activity_log/{docId} ──────────────────────────────────
    // PRISM activity logging. Server-side only.
    match /plugin_activity_log/{docId} {
      allow read, write: if false;
    }

    // ── usageLimits/{docId} ──────────────────────────────────────────
    // Rate limiting. Server-side only.
    match /usageLimits/{docId} {
      allow read, write: if false;
    }

    // ── users/{uid} ──────────────────────────────────────────────────
    // Web dashboard user docs (created by signup.html).
    // Owner can read and write their own doc.
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
